# Frontend (Vite) environment variables.
# Copy to `.env` (or `.env.local`) and adjust. Only vars prefixed VITE_ are
# exposed to the client.
#
# You normally DON'T need this file: `npm run dev` proxies /games and /socket.io
# to the backend on :8080 (see vite.config.ts), so the app is same-origin. Set
# these only to target a backend on a different origin.

# Origin for HTTP API calls. e.g. http://localhost:8080
VITE_API_BASE=

# Origin for the Socket.IO connection. e.g. http://localhost:8080
VITE_SOCKET_URL=

# Frontend (Vite) environment variables.
# Copy to `.env` (or `.env.local`) and adjust. Only vars prefixed VITE_ are
# exposed to the client. Both have sensible localhost defaults in code, so
# this file is only needed when the backend is not on localhost:8080.

# Base URL for HTTP API calls (POST /games).
VITE_API_BASE=http://localhost:8080

# Base URL for the WebSocket connection (the ?code= query is appended in code).
VITE_WS_BASE=ws://localhost:8080/ws

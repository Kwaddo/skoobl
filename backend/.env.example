# Backend (Go) environment variables.
# Copy to `.env` and adjust. docker compose reads infra/.env, not this file;
# these document what cmd/server/main.go actually consumes.

# Redis connection for room snapshots. When set, persistence is enabled and
# room state survives a backend restart; when empty, the server runs in-memory.
# Example: localhost default, or a hosted URL.
REDIS_ADDR=localhost:6379

# Snapshot TTL for room state in Redis (Go duration). Defaults to 1h.
SNAPSHOT_TTL=1h

# Cross-origin allowlist (comma-separated full origins) for REST + the Socket.IO
# handshake. LEAVE EMPTY IN PROD: the SPA is served same-origin behind nginx.
# Set only for cross-origin dev, e.g. Vite on :5173 hitting the backend:
# ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_ORIGINS=

# NOTE: the listen port is currently hardcoded to :8080 in main.go (PORT is not
# read). The Dockerfile, compose, and nginx all assume 8080.

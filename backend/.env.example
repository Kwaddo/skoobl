# Backend (Go) environment variables.
# Copy to `.env` and adjust.
#
# NOTE: cmd/server/main.go currently hardcodes :8080 and does not yet read env,
# and the Redis store (internal/store) is built+tested but not wired into the
# runtime (single-instance v1). These vars document the intended configuration
# for when those are connected — they are NOT consumed yet.

# Port the HTTP/WebSocket server listens on.
PORT=8080

# Redis connection for room snapshots + pub/sub (when wired for reconnect /
# multi-instance). Example: localhost default, or a hosted URL.
REDIS_ADDR=localhost:6379
